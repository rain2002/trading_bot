# Environment Configuration (Default: PAPER)
ENVIRONMENT=PAPER

# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/trading_db

# Broker API Keys (Paper/Simulation ONLY)
PAPER_API_KEY=your_paper_api_key_here
PAPER_API_SECRET=your_paper_api_secret_here

# Live Trading (DANGER - Leave disabled for development)
LIVE_TRADING_ENABLED=False
LIVE_API_KEY=
LIVE_API_SECRET=
