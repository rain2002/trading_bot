# Environment Configuration (Default: PAPER)
ENVIRONMENT=PAPER

# Database connection (V2 PostgreSQL Migration)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://quant:your_secure_password_here@localhost:5432/trading_db

# Broker API Keys (Paper/Simulation ONLY)
PAPER_API_KEY=your_paper_api_key_here
PAPER_API_SECRET=your_paper_api_secret_here

# Live Trading (DANGER - Leave disabled for development)
LIVE_TRADING_ENABLED=False
LIVE_API_KEY=
LIVE_API_SECRET=

# Daily Notification Webhooks (Optional - Pick Discord or Telegram)
# Option A: Discord Webhook URL (Easiest)
DISCORD_WEBHOOK_URL=

# Option B: Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
