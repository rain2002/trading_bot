# ==============================================================================
# Quantitative Hedge Fund Trading Bot - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH YOUR SECRETS.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Execution Environment (Default: PAPER, Options: PAPER, LIVE)
ENVIRONMENT=PAPER
LIVE_TRADING_ENABLED=False

# Active Market (Options: US, IN)
TRADING_MARKET=US

# Database Connection (PostgreSQL V2)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://quant:your_secure_password_here@localhost:5432/trading_db

# ------------------------------------------------------------------------------
# US Broker Credentials (Alpaca)
# ------------------------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ------------------------------------------------------------------------------
# Indian Broker Credentials (Groww - Cash & Delivery Segment CNC)
# ------------------------------------------------------------------------------
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here
GROWW_AUTH_TOKEN=your_groww_auth_or_totp_secret_here
GROWW_BASE_URL=https://api.groww.in

# ------------------------------------------------------------------------------
# Notifications & Emergency Alerts (Discord / Telegram)
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
